# Port of the app. In production this one process serves the API and the frontend, so users open
# http://<server>:<PORT>. In development the Vite dev server proxies /api to it (frontend/vite.config.js)
PORT=3012
# MongoDB connection (local or Atlas)
MONGO_URI=mongodb://localhost:27017/levantamano
# Origin of the frontend allowed by CORS. Only matters if the browser calls the API from another origin;
# as deployed, the frontend is served from the same origin
FRONTEND_ORIGIN=http://localhost:5176
# Key of the CSV export link (Power BI). Anyone with the link can read every response
EXPORT_KEY=
