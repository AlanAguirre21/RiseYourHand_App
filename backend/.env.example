# Port of the API. Keep 3000: the frontend proxies /api to it (frontend/vite.config.js)
PORT=3000
# MongoDB connection (local or Atlas)
MONGO_URI=mongodb://localhost:27017/levantamano
# Origin of the frontend allowed by CORS. Only matters if the browser calls the API directly;
# as deployed, it goes through the frontend
FRONTEND_ORIGIN=http://localhost:5173
# Key of the CSV export link (Power BI). Anyone with the link can read every response
EXPORT_KEY=
